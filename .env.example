# Copy to .env and fill in DB_PASSWORD. NEVER commit .env
#
# DB_HOST=localhost     when running the app directly (Stage 1, make run)
# DB_HOST=messages-db   is set by docker-compose.yml, ignore it here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=messages_db
DB_USER=messages_app
DB_PASSWORD=
APP_ENV=dev
APP_PORT=5000
